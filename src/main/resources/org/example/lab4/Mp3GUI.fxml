        </VBox>
        <HBox alignment="CENTER" prefHeight="54.0" prefWidth="190.0" spacing="10.0">
          <children>
            <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#onPlayClick" prefHeight="25.0" prefWidth="81.0" text="Play" />
            <Button fx:id="btnClose" mnemonicParsing="false" onAction="#onCloseClick" prefHeight="25.0" prefWidth="80.0" text="Close" />
