          </children>
          <padding>
            <Insets left="10.0" />
          </padding>
        </HBox>
      </children>
    </VBox>
  </bottom>
  <top>
    <HBox alignment="CENTER" prefHeight="39.0" prefWidth="455.0" BorderPane.alignment="CENTER">
