            <Button fx:id="btnLoadList" mnemonicParsing="false" onAction="#onLoadListClick" prefHeight="25.0" prefWidth="80.0" text="Load List" />
            <Button mnemonicParsing="false" onAction="#onSaveListClick" prefHeight="25.0" prefWidth="80.0" text="Save List" />
            <Button mnemonicParsing="false" onAction="#onAddSongClick" prefHeight="25.0" prefWidth="80.0" text="Add Song" />
            <Button mnemonicParsing="false" onAction="#onSortListClick" prefHeight="25.0" prefWidth="80.0" text="Sort List" />
          </children>
          <opaqueInsets>
            <Insets />
