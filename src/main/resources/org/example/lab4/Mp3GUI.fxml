                    </Label>
                  </children>
                </HBox>
                <HBox prefHeight="90.0" prefWidth="211.0">
                  <children>

                    <Label text="Duration: ">
                      <font>
                        <Font name="System Bold" size="14.0" />
                      </font>
                    </Label>
                    <Label fx:id="lblDuration" text="Nothing">
                      <font>
                        <Font size="14.0" />
                      </font>
                    </Label>
